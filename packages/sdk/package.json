{
  "name": "@routeplane/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Routeplane AI Gateway — a drop-in OpenAI client plus a zero-dependency core client and typed x-routeplane-* header builder.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/routeplane-core/routeplane-devtools.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/routeplane-core/routeplane-devtools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "openai": "^4",
    "typescript": "^5.5",
    "vitest": "^2"
  }
}
